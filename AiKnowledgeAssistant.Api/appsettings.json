{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Embeddings": {
    "Model": "nomic-embed-text",
    "Dimension": 768,
    "BatchSize": 16
  },
  "Chunking": {
    "MaxTokens": 500,
    "OverlapTokens": 50
  },
  "VectorStore": {
    "CollectionName": "knowledge",
    "Distance": "Cosine"
  },
  "Ingestion": {
    "MaxFilesPerRequest": 100,
    "TimeoutSeconds": 90
  }
}
